{
  "manifest_version": 3,
  "name": "NEXA Tools Pro",
  "short_name": "NEXA",
  "version": "9.0.0",
  "description": "All-in-one browser toolkit & social automation: Full Page screenshots, screen recording, media downloader, offline converter, 2000% audio boost, QR studio, and GitHub & TikTok Auto Follow/Unfollow bots.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "sidePanel",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content-github.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["content-tiktok.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NEXA Tools Pro",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
